# JustDeviceCount — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@host:5432/crowd_index?schema=public&sslmode=require"

# ── Application ───────────────────────────────────────────────────────────────
# "development" → HTTP, no SSL, TEST_USER_ID is used for the dashboard name
# "production"  → HTTPS, PROD_CERT_PATH / PROD_KEY_PATH are required
NODE_ENV="development"
PORT=3012
TZ="America/New_York"   # All timestamps and logs use this timezone

# ── Server detection ──────────────────────────────────────────────────────────
# Used by bin/www to decide whether to start HTTP or HTTPS.
# Set to the public hostname of the production server.
PRODUCTION_HOSTNAME="your-production-server.edu"

# ── SSL certificates (production only) ────────────────────────────────────────
# Required when NODE_ENV=production or HOSTNAME matches PRODUCTION_HOSTNAME.
PROD_CERT_PATH="/your-production-server.edu-cert.pem"
PROD_KEY_PATH="/your-production-server.edu-privkey.pem"

# ── Cisco CMX API credentials ─────────────────────────────────────────────────
# Base64-encode "username:password":
#   echo -n "user:pass" | base64
# Then: CMX_AUTH="Basic <result>"
CMX_AUTH="Basic YOUR_BASE64_ENCODED_CREDENTIALS_HERE"

# ── Stored data directory ─────────────────────────────────────────────────────
# Where monthly exported JSON files and big_summary.json live.
# Production: point to a directory OUTSIDE the app folder so data survives
#             deployments.
# Local dev:  leave unset — scripts fall back to <repo_root>/stored_data.
STORED_DATA_DIR=""

# ── Admin dashboard (/crowdindex/admin) ───────────────────────────────────────
# Generate a token:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Share the full URL with colleagues (no login needed):
#   https://your-server/crowdindex/admin?t=<ADMIN_TOKEN>
# Leave ADMIN_TOKEN unset to disable the gate (open access — dev only).
ADMIN_TOKEN="replace-with-output-of-crypto-randomBytes-32-base64url"

# ── Admin dashboard date-range filter ─────────────────────────────────────────
# Restricts which months are shown on /crowdindex/admin (both ends inclusive).
# Format: YYYY-MM
# Leave either value unset to show the full range in big_summary.json.
#
# Bump DASHBOARD_END_MONTH by one month after each monthly CRON run once you
# have regenerated big_summary.json with the new month's data.
DASHBOARD_START_MONTH=2025-10
DASHBOARD_END_MONTH=2026-05
