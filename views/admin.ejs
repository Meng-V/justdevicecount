<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
  <style>
    :root {
      color-scheme: light;
      --page:        #f5f5f3;
      --surface:     #ffffff;
      --border:      #e4e3df;
      --grid:        #ecebe8;
      --text:        #1b1b1a;
      --text-2:      #52514e;
      --text-3:      #7a7974;
      --accent:      #2a78d6;
      --accent-soft: #e8f1fc;
      --warn-bg:     #fff6e0;
      --warn-text:   #7a5300;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--page);
      color: var(--text);
      font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }
    a { color: var(--accent); }

    /* ---- header + tabs ---- */
    header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      position: sticky; top: 0; z-index: 10;
    }
    .header-inner, main { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
    .header-row {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 16px; flex-wrap: wrap; padding-top: 16px;
    }
    header h1 { margin: 0; font-size: 1.2rem; }
    .header-meta { color: var(--text-3); font-size: .85rem; }
    .header-meta a { color: var(--text-2); }
    .badge {
      display: inline-block; padding: 1px 8px; border-radius: 999px;
      background: var(--warn-bg); color: var(--warn-text); font-size: .8rem;
    }
    .tabs { display: flex; gap: 4px; margin-top: 10px; }
    .tab {
      border: 0; background: none; cursor: pointer; font: inherit;
      padding: 10px 14px; color: var(--text-2);
      border-bottom: 3px solid transparent;
    }
    .tab:hover { color: var(--text); }
    .tab[aria-selected="true"] { color: var(--accent); border-bottom-color: var(--accent); font-weight: 600; }

    main { padding-top: 24px; padding-bottom: 48px; }
    .panel[hidden] { display: none; }

    /* ---- stat tiles ---- */
    .tiles {
      display: grid; gap: 16px; margin-bottom: 24px;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
    .tile {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 10px; padding: 16px 18px;
    }
    .tile .label { color: var(--text-2); font-size: .85rem; }
    .tile .value { font-size: 1.9rem; font-weight: 650; line-height: 1.2; margin: 4px 0; }
    .tile .value small { font-size: .95rem; font-weight: 500; color: var(--text-2); }
    .tile .sub { color: var(--text-3); font-size: .82rem; }

    /* ---- cards ---- */
    .card {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 10px; padding: 18px 20px; margin-bottom: 24px;
      min-width: 0;
    }
    .card h2 { margin: 0 0 4px; font-size: 1.05rem; }
    .card .hint { margin: 0 0 12px; color: var(--text-3); font-size: .85rem; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .grid-2 > .card { margin-bottom: 24px; }
    @media (max-width: 900px) { .grid-2 { grid-template-columns: 1fr; gap: 0; } }
    .chart { width: 100%; height: 340px; }
    .chart.tall { height: 380px; }

    /* ---- controls ---- */
    .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 12px; }
    .controls label { font-size: .85rem; color: var(--text-2); }
    select, input[type="date"] {
      font: inherit; font-size: .9rem; padding: 5px 8px;
      border: 1px solid var(--border); border-radius: 6px; background: var(--surface);
    }
    .btn {
      display: inline-block; padding: 6px 12px; border-radius: 6px;
      font-size: .88rem; font-weight: 600; text-decoration: none; cursor: pointer;
      border: 1px solid var(--accent); background: var(--surface); color: var(--accent);
    }
    .btn:hover { background: var(--accent-soft); }
    .btn.primary { background: var(--accent); color: #fff; }
    .btn.primary:hover { background: #1c5cab; }
    .btn[aria-disabled="true"] { opacity: .4; pointer-events: none; }
    .status { font-size: .85rem; color: var(--text-3); }
    .status.err { color: #b42318; }

    .day-stats { display: flex; flex-wrap: wrap; gap: 20px; margin: 4px 0 8px; font-size: .9rem; color: var(--text-2); }
    .day-stats b { color: var(--text); font-size: 1.05rem; }

    /* ---- tables ---- */
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: .88rem; }
    th, td { padding: 7px 10px; text-align: right; border-bottom: 1px solid var(--grid); white-space: nowrap; }
    th:first-child, td:first-child { text-align: left; }
    th { color: var(--text-2); font-weight: 600; border-bottom-color: var(--border); }
    td.muted { color: var(--text-3); }
    .tag {
      display: inline-block; margin-left: 6px; padding: 0 6px; border-radius: 4px;
      font-size: .75rem; background: var(--accent-soft); color: #1c5cab;
    }
    details summary { cursor: pointer; color: var(--accent); font-size: .9rem; margin-top: 10px; }

    /* ---- notes ---- */
    .notes ul { margin: 8px 0 0; padding-left: 20px; color: var(--text-2); font-size: .9rem; }
    .notes li { margin-bottom: 6px; }
    .empty { color: var(--text-3); }
  </style>
</head>
<body>
<%
  const nf = (n) => (n === null || n === undefined) ? "—" : Number(n).toLocaleString("en-US");
  const MON = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  const WD  = ["Sun","Mon","Tue","Wed","Thu","Fri","Sat"];
  const fmtDate = (d) => {
    if (!d) return "—";
    const [y, m, day] = d.split("-").map(Number);
    return `${MON[m - 1]} ${day}, ${y}`;
  };
  const fmtDay = (d) => {
    const [y, m, day] = d.split("-").map(Number);
    return `${WD[new Date(Date.UTC(y, m - 1, day)).getUTCDay()]}, ${MON[m - 1]} ${day}, ${y}`;
  };
  const fmtRange = (g) => g.from === g.to ? fmtDate(g.from) : `${fmtDate(g.from)} – ${fmtDate(g.to)}`;
%>

<header>
  <div class="header-inner">
    <div class="header-row">
      <h1>Crowd Index Analytics</h1>
      <div class="header-meta">
        Miami University Libraries · Eastern Time
        <% if (rangeStart || rangeEnd) { %>
          · <span class="badge">Analysis limited to <%= rangeStart || "the start" %> – <%= rangeEnd || "today" %></span>
        <% } %>
        · <a href="/crowdindex/">Live page</a>
      </div>
    </div>
    <div class="tabs" role="tablist">
      <% buildings.forEach((b, i) => { %>
        <button class="tab" role="tab" id="tab-<%= b.kind %>" data-kind="<%= b.kind %>"
                aria-controls="panel-<%= b.kind %>" aria-selected="<%= i === 0 ? 'true' : 'false' %>"><%= b.name %></button>
      <% }) %>
    </div>
  </div>
</header>

<main>
<% buildings.forEach((b, i) => { %>
  <section class="panel" id="panel-<%= b.kind %>" role="tabpanel" aria-labelledby="tab-<%= b.kind %>" <%= i === 0 ? "" : "hidden" %>>

  <% if (!b.available) { %>
    <div class="card">
      <h2><%= b.name %></h2>
      <% if (b.error) { %>
        <p class="empty">The figures could not be computed (<%= b.error %>). The server log has the details.</p>
      <% } else { %>
        <p class="empty">No data in the summary files yet. They are built by
          <code>node scripts/refresh_summaries.js</code>, which the app runs every hour.</p>
      <% } %>
    </div>
  <% } else { const o = b.overview; %>

    <!-- ===== Headline figures ===== -->
    <div class="tiles">
      <div class="tile">
        <div class="label">Typical daily peak</div>
        <div class="value"><%= nf(o.avgDailyPeak) %> <small><%= b.unit %></small></div>
        <div class="sub">Average of each complete day's highest reading</div>
      </div>
      <div class="tile">
        <div class="label">Highest reading</div>
        <div class="value"><%= nf(o.peak.value) %> <small><%= b.unit %></small></div>
        <div class="sub"><%= fmtDay(o.peak.date) %> at <%= o.peak.time %></div>
      </div>
      <div class="tile">
        <div class="label">Busiest time of the week</div>
        <div class="value"><%= o.busiest ? o.busiest.weekday.slice(0, 3) + " " + o.busiest.hour : "—" %></div>
        <div class="sub"><%= o.busiest ? "Averages " + nf(o.busiest.avg) + " " + b.unit : "Not enough complete days yet" %></div>
      </div>
      <div class="tile">
        <div class="label">Complete days of data</div>
        <div class="value"><%= nf(o.completeDays) %> <small>of <%= nf(o.daysWithData) %></small></div>
        <div class="sub"><%= fmtDate(o.firstDate) %> – <%= fmtDate(o.lastDate) %> · last reading <%= o.latest.time %> on <%= fmtDate(o.latest.date) %></div>
      </div>
    </div>

    <!-- ===== Daily trend ===== -->
    <div class="card">
      <h2>Daily trend</h2>
      <p class="hint">Each day's highest reading and its average. Gaps are days with missing or incomplete data.</p>
      <div class="chart tall" id="<%= b.kind %>-trend"></div>
    </div>

    <!-- ===== Weekly pattern ===== -->
    <div class="card">
      <h2>When it is busy</h2>
      <p class="hint">Average <%= b.unit %> by day of the week and hour, complete days only.</p>
      <div class="controls">
        <label for="<%= b.kind %>-heat-month">Period</label>
        <select id="<%= b.kind %>-heat-month" data-kind="<%= b.kind %>" class="heat-month">
          <option value="all">All months</option>
          <% b.months.slice().reverse().forEach((m) => { %>
            <option value="<%= m.month %>"><%= m.label %><%= m.inProgress ? " (in progress)" : "" %></option>
          <% }) %>
        </select>
      </div>
      <div class="chart" id="<%= b.kind %>-heat"></div>
    </div>

    <div class="grid-2">
      <!-- ===== Floors ===== -->
      <div class="card">
        <h2>Floors by hour</h2>
        <p class="hint">Average devices on each floor<%= b.kind === "rec" ? " (raw device counts, before the estimate)" : "" %>, complete days only.</p>
        <div class="chart" id="<%= b.kind %>-floors"></div>
      </div>

      <!-- ===== Busiest days ===== -->
      <div class="card">
        <h2>Busiest days</h2>
        <p class="hint">Ranked by the day's highest reading, complete days only.</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Date</th><th>Highest</th><th>at</th><th>Day average</th></tr></thead>
            <tbody>
              <% b.topDays.forEach((d) => { %>
                <tr><td><%= fmtDay(d.date) %></td><td><%= nf(d.peak) %></td><td class="muted"><%= d.peakTime %></td><td><%= nf(d.avg) %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ===== Months ===== -->
    <div class="card">
      <h2>By month</h2>
      <p class="hint">Averages use complete days only. The highest reading counts every reading.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Month</th><th>Days with data</th><th>Complete days</th>
              <th>Average</th><th>Typical daily peak</th><th>Highest</th><th>on</th>
            </tr>
          </thead>
          <tbody>
            <% b.months.slice().reverse().forEach((m) => { %>
              <tr>
                <td><%= m.label %><% if (m.inProgress) { %><span class="tag">in progress</span><% } %></td>
                <td><%= m.daysWithData %></td>
                <td><%= m.completeDays %></td>
                <td><%= nf(m.avg) %></td>
                <td><%= nf(m.avgDailyPeak) %></td>
                <td><%= nf(m.peak) %></td>
                <td class="muted"><%= fmtDate(m.peakDate) %> <%= m.peakTime %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

  <% } %>

  <% if (b.bounds) { %>
    <!-- ===== One day ===== -->
    <div class="card day-card" data-kind="<%= b.kind %>">
      <h2>One day in detail</h2>
      <p class="hint">Every 15-minute reading for the chosen day.</p>
      <div class="controls">
        <label for="<%= b.kind %>-day-picker">Date</label>
        <input type="date" id="<%= b.kind %>-day-picker" class="day-picker"
               min="<%= b.bounds.min %>" max="<%= b.bounds.max %>" value="<%= b.bounds.max %>">
        <a class="btn day-csv" href="#">Download CSV</a>
        <a class="btn day-json" href="#">Download JSON</a>
        <span class="status day-status"></span>
      </div>
      <div class="day-stats"></div>
      <div class="chart day-chart" id="<%= b.kind %>-day"></div>
      <details>
        <summary>Show the readings as a table</summary>
        <div class="table-wrap"><table class="day-table"><thead></thead><tbody></tbody></table></div>
      </details>
    </div>

    <!-- ===== Export ===== -->
    <div class="card export" data-base="<%= b.urls.range %>">
      <h2>Download a date range</h2>
      <p class="hint">All 15-minute readings between two dates, as CSV or JSON. Data runs from <%= fmtDate(b.bounds.min) %> to <%= fmtDate(b.bounds.max) %>.</p>
      <div class="controls">
        <label>From</label>
        <input type="date" class="xp-from" min="<%= b.bounds.min %>" max="<%= b.bounds.max %>" value="<%= b.bounds.min %>">
        <label>To</label>
        <input type="date" class="xp-to" min="<%= b.bounds.min %>" max="<%= b.bounds.max %>" value="<%= b.bounds.max %>">
        <a class="btn primary xp-csv" href="#">CSV</a>
        <a class="btn xp-json" href="#">JSON</a>
        <span class="status xp-count"></span>
      </div>
    </div>
  <% } %>

  <% if (b.available) { %>
    <!-- ===== Notes ===== -->
    <div class="card notes">
      <h2>About these numbers</h2>
      <ul>
        <% if (b.kind === "king") { %>
          <li>Each number counts the devices (phones, laptops, tablets…) connected to King Library's Wi-Fi,
            read from IT's Cisco CMX system every 15 minutes. One person often carries more than one device,
            so this is not a head count.</li>
        <% } else { %>
          <li>Each number is an estimate of people, made from the devices connected to the Rec's Wi-Fi
            (IT's Cisco CMX system, every 15 minutes): (hourly average of devices − <%= recParams.baseline %>
            always-on devices) ÷ <%= recParams.devicesPerPatron %> devices per person. It is the same estimate the
            live Rec widget shows before it is rescaled to the widget.</li>
          <% if (b.degraded && b.degraded.count) { %>
            <li><%= nf(b.degraded.count) %> of <%= nf(b.degraded.total) %> readings
              (<%= (100 * b.degraded.count / b.degraded.total).toFixed(1) %>%) failed the ground/first-floor sanity
              check and may be over-stated. They are included above; the day view marks them.</li>
          <% } %>
        <% } %>
        <% if (b.failedReadings) { %>
          <li><%= nf(b.failedReadings) %> readings with every floor at zero are ignored: they are failed CMX
            requests (such as the certificate outage of July–August 2026), not an empty building.</li>
        <% } %>
        <li>Nothing is recorded <%= b.silentWindow %>, so those hours are left out.</li>
        <li>A day counts as complete when it has at least <%= b.minRowsPerDay %> of its
          <%= b.expectedPerDay %> expected readings. Averages, the weekly pattern, the floor chart and the
          rankings use complete days only; today is always incomplete until it is over.</li>
        <% if (b.gaps.length) { %>
          <li>Missing or incomplete days (usually CMX outages):
            <%= b.gaps.slice(-12).reverse().map(fmtRange).join("; ") %><%= b.gaps.length > 12 ? `; and ${b.gaps.length - 12} earlier` : "" %>.</li>
        <% } %>
        <li>All times are Eastern Time, with daylight saving time applied to each reading.</li>
      </ul>
    </div>
  <% } %>

  </section>
<% }) %>
</main>

<script>
const BUILDINGS = <%- chartJson %>;
const BY_KIND = Object.fromEntries(BUILDINGS.map((b) => [b.kind, b]));

// Categorical slots in fixed order; sequential blue ramp for the heat map.
const SERIES  = ["#2a78d6", "#eb6834", "#1baf7a", "#eda100"];
const NEUTRAL = "#52514e";
const SUSPECT = "#d03b3b";
const HEAT    = [[0, "#eef4fd"], [0.15, "#cde2fb"], [0.4, "#86b6ef"], [0.65, "#2a78d6"], [0.85, "#1c5cab"], [1, "#0d366b"]];

const CFG = { displayModeBar: false, responsive: true };
const BASE = {
  paper_bgcolor: "#ffffff",
  plot_bgcolor:  "#ffffff",
  font:   { family: "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", size: 12, color: "#52514e" },
  margin: { t: 30, r: 16, b: 44, l: 56 },
  hoverlabel: { bgcolor: "#ffffff", bordercolor: "#e4e3df", font: { color: "#1b1b1a" } },
  legend: { orientation: "h", x: 0, y: 1.12 },
};
const axis = (extra) => ({ gridcolor: "#ecebe8", zerolinecolor: "#e4e3df", linecolor: "#e4e3df", ...extra });

// ---------------------------------------------------------------- charts
function drawTrend(b) {
  const x = b.days.map((d) => d.date);
  Plotly.newPlot(b.kind + "-trend", [
    { name: "Daily peak", x, y: b.days.map((d) => d.peak), type: "scatter", mode: "lines",
      line: { color: SERIES[0], width: 2 }, connectgaps: false },
    { name: "Daily average", x, y: b.days.map((d) => d.avg), type: "scatter", mode: "lines",
      line: { color: SERIES[1], width: 2 }, connectgaps: false },
  ], {
    ...BASE,
    hovermode: "x unified",
    xaxis: axis({
      type: "date",
      rangeselector: { x: 1, xanchor: "right", y: 1.12, buttons: [
        { count: 1, label: "1 month",  step: "month", stepmode: "backward" },
        { count: 3, label: "3 months", step: "month", stepmode: "backward" },
        { count: 1, label: "1 year",   step: "year",  stepmode: "backward" },
        { step: "all", label: "All" },
      ] },
    }),
    yaxis: axis({ title: { text: b.unitTitle }, rangemode: "tozero" }),
  }, CFG);
}

function drawHeat(b, period) {
  const z = period === "all" ? b.heat.all : b.heat.byMonth[period];
  Plotly.react(b.kind + "-heat", [{
    type: "heatmap", z, x: b.hours, y: b.weekdays,
    colorscale: HEAT, zmin: 0, hoverongaps: false, xgap: 2, ygap: 2,
    colorbar: { thickness: 12, outlinewidth: 0 },
    hovertemplate: "%{y} %{x}<br><b>%{z}</b> " + b.unit + "<extra></extra>",
  }], {
    ...BASE,
    margin: { t: 10, r: 16, b: 44, l: 90 },
    xaxis: axis({ type: "category", title: { text: "Hour (ET)" }, showgrid: false }),
    yaxis: axis({ autorange: "reversed", showgrid: false }),
  }, CFG);
}

function drawFloors(b) {
  Plotly.newPlot(b.kind + "-floors", b.floorsByHour.map((f, i) => ({
    name: f.name, x: b.hours, y: f.avg, type: "scatter", mode: "lines",
    line: { color: SERIES[i], width: 2 },
  })), {
    ...BASE,
    hovermode: "x unified",
    xaxis: axis({ type: "category", title: { text: "Hour (ET)" }, dtick: 3, tickangle: 0 }),
    yaxis: axis({ title: { text: "Devices" }, rangemode: "tozero" }),
  }, CFG);
}

// ---------------------------------------------------------------- one day
function setupDay(card) {
  const b       = BY_KIND[card.dataset.kind];
  const picker  = card.querySelector(".day-picker");
  const csv     = card.querySelector(".day-csv");
  const json    = card.querySelector(".day-json");
  const status  = card.querySelector(".day-status");
  const stats   = card.querySelector(".day-stats");
  const thead   = card.querySelector(".day-table thead");
  const tbody   = card.querySelector(".day-table tbody");
  const chartId = b.kind + "-day";
  const isRec   = b.kind === "rec";

  async function load() {
    const date = picker.value;
    if (!date) return;
    const q = "?date=" + encodeURIComponent(date);
    csv.href  = b.urls.day + ".csv"  + q;
    json.href = b.urls.day + ".json" + q;
    status.textContent = "Loading…";
    status.className = "status day-status";

    let payload;
    try {
      const resp = await fetch(b.urls.day + q, { credentials: "same-origin" });
      payload = await resp.json();
      if (!resp.ok) throw new Error(payload.error || "Request failed");
    } catch (e) {
      status.textContent = "Error: " + e.message;
      status.className = "status day-status err";
      return;
    }

    const recs = payload.records;
    [csv, json].forEach((a) => a.setAttribute("aria-disabled", recs.length ? "false" : "true"));
    if (!recs.length) {
      stats.innerHTML = "";
      thead.innerHTML = tbody.innerHTML = "";
      Plotly.purge(chartId);
      status.textContent = "No readings on this day.";
      return;
    }

    const s = payload.stats;
    const suspect = isRec ? recs.filter((r) => r.degraded).length : 0;
    status.textContent = suspect ? suspect + " of " + recs.length + " readings failed the sanity check (marked)." : "";
    stats.innerHTML =
      "<span>Readings <b>" + s.count + "</b></span>" +
      "<span>Average <b>" + s.avg + "</b></span>" +
      "<span>Highest <b>" + s.peak + "</b> at " + s.peakTime + "</span>" +
      "<span>Lowest <b>" + s.low + "</b> at " + s.lowTime + "</span>";

    const x = recs.map((r) => r.time);
    let traces;
    if (isRec) {
      traces = [{ name: "Estimated people", x, y: recs.map((r) => r.patrons), type: "scatter", mode: "lines",
                  line: { color: SERIES[0], width: 2 } }];
      if (suspect) {
        const bad = recs.filter((r) => r.degraded);
        traces.push({ name: "Failed sanity check", x: bad.map((r) => r.time), y: bad.map((r) => r.patrons),
                      type: "scatter", mode: "markers", marker: { color: SUSPECT, size: 8, symbol: "x" } });
      }
    } else {
      traces = [{ name: "Total", x, y: recs.map((r) => r.patrons), type: "scatter", mode: "lines",
                  line: { color: NEUTRAL, width: 2.5 } }]
        .concat(["ground", "first", "second", "third"].map((k, i) => ({
          name: b.floors[i], x, y: recs.map((r) => r[k]), type: "scatter", mode: "lines",
          line: { color: SERIES[i], width: 1.5 },
        })));
    }
    Plotly.newPlot(chartId, traces, {
      ...BASE,
      hovermode: "x unified",
      xaxis: axis({ type: "category", title: { text: "Time (ET)" }, nticks: 12 }),
      yaxis: axis({ title: { text: b.unitTitle }, rangemode: "tozero" }),
    }, CFG);

    const cols = isRec
      ? [["Time", "time"], ["Estimated people", "patrons"], ["Devices (raw)", "raw"], ["Ground", "ground"], ["First", "first"]]
      : [["Time", "time"], ["Total", "patrons"], ["Ground", "ground"], ["First", "first"], ["Second", "second"], ["Third", "third"]];
    thead.innerHTML = "<tr>" + cols.map((c) => "<th>" + c[0] + "</th>").join("") + (isRec ? "<th></th>" : "") + "</tr>";
    tbody.innerHTML = recs.map((r) =>
      "<tr>" + cols.map((c) => "<td>" + r[c[1]] + "</td>").join("") +
      (isRec ? "<td class='muted'>" + (r.degraded ? "failed check" : "") + "</td>" : "") + "</tr>"
    ).join("");
  }

  picker.addEventListener("change", load);
  return load;
}

// ---------------------------------------------------------------- export
function setupExport(card) {
  const base  = card.dataset.base;
  const from  = card.querySelector(".xp-from");
  const to    = card.querySelector(".xp-to");
  const csv   = card.querySelector(".xp-csv");
  const json  = card.querySelector(".xp-json");
  const count = card.querySelector(".xp-count");
  let timer;

  const enable = (on) => [csv, json].forEach((a) => a.setAttribute("aria-disabled", on ? "false" : "true"));

  async function refresh() {
    if (!from.value || !to.value) return;
    if (from.value > to.value) {
      count.textContent = "The start date is after the end date.";
      count.className = "status xp-count err";
      enable(false);
      return;
    }
    const qs = "?from=" + encodeURIComponent(from.value) + "&to=" + encodeURIComponent(to.value);
    csv.href  = base + ".csv"  + qs;
    json.href = base + ".json" + qs;
    count.textContent = "Counting…";
    count.className = "status xp-count";
    try {
      const resp = await fetch(base + "/info" + qs, { credentials: "same-origin" });
      const info = await resp.json();
      if (!resp.ok) throw new Error(info.error || "Request failed");
      count.textContent = info.count
        ? info.count.toLocaleString("en-US") + " readings across " + info.days + " day(s)"
        : "No readings in this range.";
      enable(info.count > 0);
    } catch (e) {
      count.textContent = e.message;
      count.className = "status xp-count err";
      enable(false);
    }
  }

  [from, to].forEach((el) => el.addEventListener("change", () => {
    clearTimeout(timer);
    timer = setTimeout(refresh, 150);
  }));
  refresh();
}

// ---------------------------------------------------------------- tabs
const dayLoaders = {};
document.querySelectorAll(".day-card").forEach((c) => { dayLoaders[c.dataset.kind] = setupDay(c); });
document.querySelectorAll(".export").forEach(setupExport);
document.querySelectorAll(".heat-month").forEach((sel) =>
  sel.addEventListener("change", () => drawHeat(BY_KIND[sel.dataset.kind], sel.value)));

const drawn = {};
function showTab(kind) {
  if (!BY_KIND[kind]) kind = BUILDINGS[0].kind;
  document.querySelectorAll(".tab").forEach((t) =>
    t.setAttribute("aria-selected", t.dataset.kind === kind ? "true" : "false"));
  document.querySelectorAll(".panel").forEach((p) => { p.hidden = p.id !== "panel-" + kind; });

  // Plotly needs a visible container to size itself, so each tab draws on first view.
  if (!drawn[kind]) {
    drawn[kind] = true;
    const b = BY_KIND[kind];
    if (b.available) {
      drawTrend(b);
      drawHeat(b, "all");
      drawFloors(b);
    }
    if (dayLoaders[kind]) dayLoaders[kind]();
  }
}

document.querySelectorAll(".tab").forEach((t) => t.addEventListener("click", () => {
  history.replaceState(null, "", "#" + t.dataset.kind);
  showTab(t.dataset.kind);
}));
showTab(location.hash.slice(1));
</script>
