{
  "address": {
    "host": "https://your-cmx-server.institution.edu/",
    "ground-add": "api/location/v3/clients?floorId=YOUR_GROUND_FLOOR_ID",
    "first-add": "api/location/v3/clients?floorId=YOUR_FIRST_FLOOR_ID",
    "second-add": "api/location/v3/clients?floorId=YOUR_SECOND_FLOOR_ID",
    "third-add": "api/location/v3/clients?floorId=YOUR_THIRD_FLOOR_ID",
    "rec-first": "api/location/v3/clients?floorId=YOUR_REC_FIRST_FLOOR_ID",
    "rec-ground": "api/location/v3/clients?floorId=YOUR_REC_GROUND_FLOOR_ID",
    "king-all": "api/location/v3/clients?mapHierarchy=Your%20Library%20Name",
    "all": "api/location/v1/history/clients"
  },
  "app": {
    "port": 3000,
    "auth": "Basic YOUR_BASE64_ENCODED_CREDENTIALS_HERE"
  },
  "rec": {
    "baselineDevices": 10,
    "devicesPerPatron": 1.2,
    "groundFirstGate": 1.0,
    "capacity": 200,
    "widgetMax": 200,
    "hours": {
      "mon": ["06:00", "23:00"],
      "tue": ["06:00", "23:00"],
      "wed": ["06:00", "23:00"],
      "thu": ["06:00", "23:00"],
      "fri": ["06:00", "22:00"],
      "sat": ["08:00", "22:00"],
      "sun": ["10:00", "22:00"]
    },
    "comment": "hours = Rec opening hours (ET), Fall 2026 (Aug 21 - Dec 9) from miamioh.edu/athletics-recreation/recreation/about/hours.html. UPDATE EACH TERM: the baseline is measured during closed hours, and patrons read 0 outside these hours. baselineDevices = fallback baseline used only when no closed-hours readings exist (e.g. after an outage). capacity = real head-count capacity; widgetMax = MAX_CAPACITY hard-coded in the public Rec widget. /recapi scales data.patrons by widgetMax/capacity; they are equal until the Rec gives us a real capacity."
  },
  "collection": {
    "comment": "Silent window [start, end) in local hours: DB writes are skipped while start <= hour < end.",
    "silentHours": {
      "king": { "start": 2, "end": 7 },
      "rec":  { "start": 2, "end": 5 }
    }
  }
}
