// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// King Library — full per-floor detail (4 floors + device position maps)
model DeviceData {
  id                String   @id @default(cuid())
  timeStamp         DateTime @default(now())
  uniqUserTotal     String[] // Array of device IDs
  uniqUserGround    Json     // Map of device positions for ground floor
  uniqUserFirst     Json     // Map of device positions for first floor  
  uniqUserSecond    Json     // Map of device positions for second floor
  uniqUserThird     Json     // Map of device positions for third floor
  patrons           Int      // Total unique patrons count
  countByFloor      Int[]    // Array of counts [ground, first, second, third]
  
  @@map("device_data")
  @@index([timeStamp])
  @@index([patrons])
}

// Recreation Center — lightweight count only (2 floors).
// patrons is the RAW deduplicated device count; the staff/baseline offset
// (config: rec.staffOffset) is applied at read time, not stored here.
model RecData {
  id           String   @id @default(cuid())
  timeStamp    DateTime @default(now())
  patrons      Int      // Raw unique device count across both floors
  countByFloor Int[]    // Per-floor counts [ground, first]

  @@map("rec_data")
  @@index([timeStamp])
  @@index([patrons])
}
